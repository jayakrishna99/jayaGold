# Example nginx server block for jayagoldbuyers.com
# Copy to /etc/nginx/sites-available/jayagoldbuyers.com,
# symlink into sites-enabled, then run: sudo certbot --nginx -d jayagoldbuyers.com -d www.jayagoldbuyers.com

server {
    listen 80;
    server_name jayagoldbuyers.com www.jayagoldbuyers.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
